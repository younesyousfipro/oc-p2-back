# task-tests - exclusion du code genere par Lombok du calcul de couverture.
#
# addLombokGeneratedAnnotation fait annoter tout ce que Lombok genere (accesseurs,
# equals, hashCode, toString, constructeurs) avec @lombok.Generated. JaCoCo ignore
# automatiquement les methodes portant une annotation nommee "Generated".
#
# Sans cela, 1326 des 1845 instructions non couvertes se trouvaient dans les DTO et
# les entites : le seuil de 80% aurait plafonne a ~41% quel que soit le nombre de
# tests ecrits. Seul le code ecrit a la main est desormais mesure.
#
# stopBubbling evite que Lombok remonte chercher une configuration dans les dossiers
# parents.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
